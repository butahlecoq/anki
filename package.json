{
  "name": "kiroku",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run build && vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:status": "node --test scripts/status-report.test.mjs scripts/acceptance-evidence.test.mjs",
    "premerge": "node scripts/premerge-acceptance.mjs",
    "status:check": "node scripts/status-report.mjs --check",
    "drift": "node scripts/drift-check.mjs",
    "status": "node scripts/status-report.mjs",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "npm run server:build && node --enable-source-maps dist-server/server/index.js",
    "server:pair": "npm run server:build && node --enable-source-maps dist-server/server/index.js --pairing-code",
    "server:devices": "npm run server:build && node --enable-source-maps dist-server/server/index.js --devices",
    "server:revoke": "npm run server:build && node --enable-source-maps dist-server/server/index.js --revoke-device",
    "test:server": "npm run server:build && node --test dist-server/server/**/*.test.js",
    "test:e2e": "playwright test",
    "test:anki-compatibility": "node scripts/test-anki-compatibility.mjs",
    "check:push": "npm run typecheck && npm run lint && npm run test && npm run test:status && npm run test:server",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:status && npm run test:server && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "ankipack": "^0.3.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql.js": "1.12.0",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sql.js": "^1.4.11",
    "@vite-pwa/assets-generator": "^1.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.38.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.3"
  }
}
